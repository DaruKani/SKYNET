{
  "apps": [
    {
      "name": "skynet-arena",
      "cwd": ".",
      "script": "server/index.js",
      "interpreter": "node",
      "instances": 1,
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "out_file": "./pm2.logs/skynet-arena-out.log",
      "error_file": "./pm2.logs/skynet-arena-error.log",
      "merge_logs": true,
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "env": {
        "NODE_ENV": "production",
        "SKYNET_ARENA_HOST": "127.0.0.1",
        "SKYNET_ARENA_PORT": "3000",
        "SKYNET_ARENA_DATABASE": "data/arena.sqlite"
      }
    }
  ]
}
